  "formulas": {
    "same_rail": "headroom = overdrive - valid_floor; residual = headroom - slew*(response_ns/1000)",
    "island": "I = load + reverse_leakage; V0 = source_min - blocking_drop - I*ESR; Q = C*max(0,V0-valid_floor); t = Q/I",
