		(uuid "3bca5580-0eab-5b70-9602-2d37794bebca")
	)
	(text "Qualification target: VBAT_FUSED within +/-44 V and stored VIN_RAW <=44 V. These are required bounds, not measured results."
		(at 16 172 0)
		(effects
			(font
				(size 1.7 1.7)
			)
			(justify left bottom)
		)
		(uuid "2c32a6c7-e06b-5fad-b192-19efecaf4b0a")
	)
	(text "At those bounds D12 blocks at most 88 V against 100 V rating. Do not infer an unlimited surge rating from the TVS value."
