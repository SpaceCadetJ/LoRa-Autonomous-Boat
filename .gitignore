# ============================================================
# LoRa Autonomous Boat Controller - .gitignore
# ============================================================

# === STM32CubeIDE / GCC ARM Build Artifacts ===
firmware/Debug/
firmware/Release/
firmware/.settings/
firmware/*.launch
firmware/.cproject
firmware/.project
firmware/.mxproject
*.o
*.d
*.su
*.elf
*.map
*.bin
*.hex
*.list
*.cyclo

# === KiCad (all projects under hardware/) ===
hardware/**/*.kicad_pcb-bak
hardware/**/*.kicad_sch-bak
hardware/**/*.kicad_prl
hardware/**/*-backups/
hardware/**/_autosave-*
hardware/**/fp-info-cache
hardware/**/*.lck
*.lck
_backup_*/
hardware/**/_build/

# === Claude Code local settings (never commit) ===
.claude/
**/.claude/

# === OS ===
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# === IDE ===
.vscode/
.idea/

# === Python ===
__pycache__/
*.pyc
